# Copy this file to backend/.env and fill in real values.
# backend/.env is ignored by Git and must never be committed.

# ── Groq (required) ───────────────────────────────────────────────────────────
# One or more API keys, comma-separated. The backend rotates between them and
# respects their rate limits. Get keys at https://console.groq.com
GROQ_API_KEYS=gsk_your_first_key,gsk_your_second_key
GROQ_MAIN_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── Auth (required) ───────────────────────────────────────────────────────────
# Secret used to sign login tokens. Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Object storage (must match the app-minio service in docker-compose.yml) ───
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rfp-documents

# ── Pipeline tuning (optional; defaults shown) ────────────────────────────────
EVIDENCE_TOP_K=5
# hybrid (dense + BM25) | dense | sparse  — the last two are for experiments
RETRIEVAL_MODE=hybrid
RERANK_ENABLED=true
MATRIX_REQUIREMENTS_ONLY=true
EXTRACT_VENDOR_CLAIMS=true
REQUIRE_LOCKED_RUBRIC=true
MAX_UPLOAD_SIZE_MB=200

# ── Groq rate limiting (optional; defaults shown) ─────────────────────────────
GROQ_TPM_PER_KEY=7000
GROQ_MAX_WAIT_SECONDS=900

# Note: DATABASE_URL, REDIS_URL, MILVUS_HOST/PORT and S3_ENDPOINT are set
# inline in docker-compose.yml for the Docker network and do not belong here.
